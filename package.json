{
  "name": "servicepulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npx ngrok http 5174 --url=https://amber-coil-fanning.ngrok-free.dev\"",
    "dev:standalone": "vite",
    "tunnel": "npx ngrok http 5174 --url=https://amber-coil-fanning.ngrok-free.dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/verify/run.mjs",
    "test:live": "node --import tsx scripts/verify/run.mjs --live",
    "test:e2e": "node --import tsx scripts/verify/run.mjs --e2e",
    "test:all": "node --import tsx scripts/verify/run.mjs --all",
    "preview": "vite preview",
    "db:seed": "tsx supabase/seed.ts",
    "db:clean": "tsx supabase/clear-demo-data.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.474.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
