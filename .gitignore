# ============================================
# ServicePulse — .gitignore
# ============================================

# ---------- Dependencies ----------
node_modules/
node_modules/.cache
node_modules/.vite

# ---------- Build output ----------
dist/
dist-ssr/
build/
*.tsbuildinfo

# ---------- Environment files (NEVER commit secrets) ----------
.env
.env.*
.env.local
.env.*.local
.env.production
.env.staging
.env.development
!.env.example

# ---------- Secrets, Credentials & Keys ----------
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.keystore
id_rsa*
*.pub
credentials.json
client_secret*.json
service-account*.json
*service_account*.json

# ---------- Local temp / debugging ----------
tmp-scan/
scratch/
.cache/
*.local

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
*~

# ---------- Tooling ----------
.ngrok.yml
ngrok.yml
*.ngrok.log
.turbo/

# ---------- Supabase CLI cache & database backups ----------
supabase/.temp/
supabase/purge-backup-*.json
*.sqlite
*.sqlite3
*.db
*.sql.bak
*.dump

# ---------- Local junk / stray artifacts ----------
nul

# ---------- Presentation & media (not part of the app repo) ----------
*.pptx
scripts/pptx/

# ---------- Local docs / research (keep out of the app repo) ----------
docs/

# ---------- n8n workflows (managed in the n8n instance, not deployed with frontend) ----------
n8n/

# ---------- Supabase generated types ----------
src/types/generated/

# ---------- Misc generated ----------
coverage/
.nyc_output/
