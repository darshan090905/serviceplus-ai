# Supabase (frontend reads these — anon role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL the payment QR encodes. OPTIONAL in production — when the app is
# served from a public domain (e.g. https://servicepulse.example.com) the QR
# automatically uses that origin, so this can stay blank.
# Only set it for local dev served from localhost when you need a reachable
# address for scanning (your PC's LAN IP or a tunnel URL):
#   VITE_APP_URL=http://192.168.1.100:5173
VITE_APP_URL=

# n8n backend API (optional — when set, the AI panels route through these
# webhooks on the company n8n instance instead of the in-memory fallback).
# Set to the n8n origin only; the app appends /webhook/... paths:
#   VITE_API_BASE_URL=https://8n-csr-interns.slicearrow.com
VITE_API_BASE_URL=

# Used only by `npm run db:seed` (Dashboard → Settings → API keys)
SUPABASE_SERVICE_ROLE_KEY=